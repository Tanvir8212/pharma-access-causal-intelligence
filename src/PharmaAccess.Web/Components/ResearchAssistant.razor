@using PharmaAccess.Llm
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@inject IConfiguration Configuration

<main>
    <p class="eyebrow">PHARMAACCESS CAUSAL INTELLIGENCE</p>
    <h1>Research Assistant</h1>
    <p>Ask about the finalized predictive and observational causal research. Answers are restricted to verified public evidence.</p>
    <label for="question">Ask a question</label>
    <textarea id="question" @bind="question" rows="4" placeholder="What was the locked-test ROC AUC?"></textarea>
    <button type="button" @onclick="AskAsync" disabled="@busy">Ask</button>

    @if (busy)
    {
        <p role="status">Checking the research evidence…</p>
    }
    else if (!string.IsNullOrWhiteSpace(feedback))
    {
        <p role="alert">@feedback</p>
    }

    @if (response is not null)
    {
        <section>
            <div class="status">@response.ValidationStatus · @response.Provider / @response.Model</div>
            <h2>Answer</h2>
            <span class="badge">@Label(response.ExplanationType)</span>
            <p>@response.Answer</p>
            @if (response.Citations.Length > 0)
            {
                <h2>Evidence sources</h2>
                <ul>
                    @foreach (var source in response.Citations)
                    {
                        <li><code>@source.SourceIdentifier</code> — @source.Title, @source.Section <small>@source.SourcePath</small></li>
                    }
                </ul>
            }
            <h2>Methodological warnings</h2>
            <ul>@foreach (var warning in response.Warnings) { <li>@warning</li> }</ul>
        </section>
    }
</main>

@code {
    private string question = "";
    private bool busy;
    private string? feedback;
    private AssistantAskResponse? response;

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(question))
        {
            feedback = "Enter a research question before asking.";
            response = null;
            return;
        }

        busy = true;
        feedback = null;
        response = null;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        var configuredSeconds = Configuration.GetValue<int?>("ResearchAssistant:RequestTimeoutSeconds") ?? 30;
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(Math.Clamp(configuredSeconds, 1, 30)));
        try
        {
            var request = question;
            response = await Task.Run(async () =>
            {
                var assistant = Services.GetRequiredService<ResearchAssistantService>();
                return await assistant.AskAsync(request, timeout.Token);
            }, timeout.Token).WaitAsync(timeout.Token);
        }
        catch (OperationCanceledException) when (timeout.IsCancellationRequested)
        {
            feedback = "The research assistant timed out. Please try again.";
        }
        catch (Exception)
        {
            feedback = "The research assistant is temporarily unavailable. Please try again.";
        }
        finally
        {
            busy = false;
        }
    }
    private static string Label(string type) => type switch
    {
        "causal" => "Observational causal explanation",
        "predictive" => "Predictive explanation",
        _ => "Unsupported / fallback"
    };
}
