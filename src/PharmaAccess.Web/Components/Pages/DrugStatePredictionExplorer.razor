@page "/drug-state-prediction-explorer"
@using PharmaAccess.Application.MachineLearning
@using System.Globalization
@inject IHistoricalPredictionReplayService Replay
@inject IDynamicAsOfPredictionService Dynamic
@inject IResearchLaunchCatalogService Catalog
@inject IHistoricalReplayExplanationService ReplayExplainer
@inject IDynamicAsOfExplanationService DynamicExplainer
<PageTitle>Drug State Prediction Explorer</PageTitle>

<main class="explorer business-explorer">
 <header class="business-header">
  <div><p class="eyebrow">MARKET ACCESS RESEARCH ANALYTICS</p><h1>Drug State Prediction Explorer</h1><p class="business-subtitle">Explore which eligible U.S. Medicaid jurisdictions have the highest model-estimated probability of first observed utilization in the next quarter.</p></div>
  <div class="research-status" aria-label="Research governance status"><strong>Research / Development</strong><span>ValidationSelected</span><span>Not Production Approved</span></div>
 </header>
 <section class="orientation" aria-labelledby="orientation-title"><div><h2 id="orientation-title">What does this tell me?</h2><p>Select a generic product and historical quarter. The model ranks eligible states where the product had not yet appeared in Medicaid data and estimates the probability of first observed eligible utilization in the next quarter.</p></div><details><summary>How to use this page</summary><ol class="workflow"><li><span>1</span>Choose a product</li><li><span>2</span>Choose mode and quarter</li><li><span>3</span>Review ranked states</li><li><span>4</span>Read AI summary or export</li></ol></details></section>
 @if(!string.IsNullOrWhiteSpace(_error)){<p role="status" class="error">@_error</p>}

 @if(_selected is null){
 <section class="discovery" aria-labelledby="discovery-title">
  <div class="section-heading"><div><p class="step-label">STEP 1</p><h2 id="discovery-title">Choose a generic product</h2><p>Search FDA product metadata or start with the latest eligible approvals represented in this research dataset.</p></div><span class="coverage">Dataset coverage: 2021–2025</span></div>
  <label class="search-label" for="product-search">Search eligible products</label><input id="product-search" class="product-search" type="search" placeholder="Search drug name, active ingredient, ANDA, or launch ID..." @bind="_search" @bind:event="oninput" autocomplete="off" />
  <div class="filter-row"><label>Approval year<select @bind="_approvalYear"><option value="0">All years</option>@foreach(var year in ApprovalYears){<option value="@year">@year</option>}</select></label><label>Dosage form<select @bind="_form"><option value="">All forms</option>@foreach(var form in AvailableForms){<option value="@form">@BusinessText(form)</option>}</select></label><button class="secondary-action" @onclick="ToggleBrowse">@(_browseAll?"Show latest approvals":"Browse all eligible products")</button></div>
  @if(string.IsNullOrWhiteSpace(_search)&&!_browseAll){<div class="section-heading recent-heading"><div><h3>Latest FDA approvals in this research dataset</h3><p>Eligible products ordered by FDA approval date in the verified local dataset.</p></div></div><div class="product-grid">@foreach(var launch in RecentLaunches){@ProductCard(launch)}</div>}
  else {<div class="product-browser" aria-live="polite"><p><strong>@DiscoveryResults.Count</strong> matching eligible products</p>@if(DiscoveryResults.Count==0){<p class="empty-state">No products match these search and filter choices. Try a broader product name, ANDA, year, or form.</p>}else{<div class="product-grid">@foreach(var launch in DiscoveryResults){@ProductCard(launch)}</div>}</div>}
  @if(string.IsNullOrWhiteSpace(_search)&&!_browseAll&&RecentLaunches.Count==0){<p class="empty-state">Search for a product above, or choose one of the latest eligible FDA approvals.</p>}
 </section>}
 else {
 <section class="selected-product" aria-labelledby="selected-title"><div><p class="step-label">SELECTED PRODUCT</p><h2 id="selected-title">@BusinessText(_selected.PrimaryProductName)</h2>@if(ShowIngredient(_selected)){<p><span>Active ingredient</span><strong>@JoinBusiness(_selected.ActiveIngredients)</strong></p>}</div><dl><div><dt>ANDA</dt><dd>@_selected.Anda</dd></div><div><dt>FDA approval</dt><dd>@_selected.ApprovalDate?.ToString("MMMM d, yyyy",CultureInfo.InvariantCulture)</dd></div><div><dt>Dosage form</dt><dd>@(_selected.Forms.Count>0?JoinBusiness(_selected.Forms):"Not available")</dd></div><div><dt>Research launch ID</dt><dd>@_selected.GenericLaunchId</dd></div></dl><button class="link-button" @onclick="ChangeProduct">Change product</button></section>

 <section class="analysis-setup" aria-labelledby="setup-title"><p class="step-label">STEP 2</p><h2 id="setup-title">Analysis setup</h2><fieldset class="mode-cards"><legend>Prediction mode</legend><label class="mode-card @(_mode=="Historical"?"selected":"")"><input type="radio" name="mode" value="Historical" checked="@(_mode=="Historical")" @onchange="ModeChanged" /><span><strong>Historical Replay</strong><small>Verification / Research</small><em>Reproduce a prediction from the model's verified historical test set.</em></span></label><label class="mode-card @(_mode=="Dynamic"?"selected":"")"><input type="radio" name="mode" value="Dynamic" checked="@(_mode=="Dynamic")" @onchange="ModeChanged" /><span><strong>Dynamic As-Of Research Prediction</strong><small>Historical scenario</small><em>Reconstruct what the model would have known at a historical point and estimate state entry in the following quarter.</em></span></label></fieldset>
  <details class="mode-help"><summary>Which mode should I use?</summary><p>Use Historical Replay to reproduce a formally verified test case. Use Dynamic As-Of to explore what the model would have predicted using information available at a chosen historical point.</p></details>
  <div class="quarter-run"><label for="quarter">As-of quarter<select id="quarter" value="@_quarter" @onchange="QuarterChanged"><option value="0">Choose a historical quarter</option>@foreach(var q in _quarters){<option value="@q">@ExplorerPresentation.Quarter(q)</option>}</select></label>@if(_quarter>0){<div class="quarter-context" aria-live="polite"><span>Known through<strong>@ExplorerPresentation.Quarter(_quarter)</strong></span><span>Predicting<strong>@ExplorerPresentation.Quarter(NextQuarter(_quarter))</strong></span></div>}<button class="primary-action" disabled="@(_loading||_quarter==0)" @onclick="Score">@(_loading?LoadingMessage:_mode=="Dynamic"?"Run dynamic prediction":"Run historical replay")</button></div>
 </section>}

 @if(CurrentStates is not null){<section class="results" aria-live="polite" aria-labelledby="summary-title"><div class="section-heading"><div><p class="step-label">PREDICTION RESULT</p><h2 id="summary-title">Prediction Summary</h2></div><span class="completion-status">Analysis complete</span></div>
  <div class="metric-grid"><div><span>Target quarter</span><strong>@ExplorerPresentation.Quarter(CurrentTarget)</strong></div><div><span>Eligible candidate states</span><strong>@CurrentStates.Count</strong></div><div><span>States meeting research threshold</span><strong>@CurrentStates.Count(x=>x.AboveSelectedThreshold)</strong></div><div><span>Highest-ranked state</span><strong>@CurrentStates.OrderBy(x=>x.Rank).First().StateName</strong></div><div><span>Highest probability</span><strong>@ExplorerPresentation.Percent(CurrentStates.OrderBy(x=>x.Rank).First().Probability)</strong></div><div><span>Selected research threshold</span><strong>@ExplorerPresentation.Percent(CurrentThreshold)</strong></div></div>
  <p class="result-statement">@ExplorerPresentation.Summary(CurrentStates,CurrentThreshold)</p>
  <div class="result-actions"><button class="ai-action" disabled="@_explaining" @onclick="Explain">@(_explaining?"Generating AI summary...":"Generate AI summary")</button>@if(_explanation is not null){<button class="secondary-action" @onclick="OpenInsights">AI summary</button>}@if(_exports is not null){<details class="export-menu"><summary>Download / Export</summary><a download="@_exports.CsvFileName" href="@CsvHref">Download CSV</a><a download="@_exports.JsonFileName" href="@JsonHref">Download JSON</a></details>}</div>
  @if(_mode=="Historical"&&_historical is not null){<section class="outcome-check" aria-labelledby="outcome-title"><div><p class="step-label">VERIFIED REPLAY OUTCOME</p><h3 id="outcome-title">Historical outcome check</h3><p>@_historical.HistoricalOutcomeSummary</p></div><dl><div><dt>Actual observed outcome in @ExplorerPresentation.Quarter(_historical.TargetQuarter)</dt><dd>@(_historical.AnyActualEntryObserved?$"{_historical.ActualObservedEntryCount} state{(_historical.ActualObservedEntryCount==1?"":"s")} entered":"No actual state entered")</dd></div><div><dt>Top-predicted state check</dt><dd>@(_historical.TopPredictedStateActuallyEntered?"Correct — the top-predicted state entered":"Incorrect — the top-predicted state did not enter")</dd></div><div><dt>Best actual observed rank</dt><dd>@(_historical.BestActualObservedRank is int rank?$"Rank {rank}":"No observed entry")</dd></div><div><dt>Threshold check</dt><dd>@(_historical.ThresholdDecisionCorrect?"Matched the actual outcome":"Did not match the actual outcome")</dd></div></dl>@if(_historical.ActualObservedStates.Count>1){<details><summary>Show actual observed states</summary><ul>@foreach(var state in _historical.ActualObservedStates){<li>Rank @state.Rank — @state.StateName (@state.StateCode)</li>}</ul></details>}</section>}
  @if(_explaining){<aside class="ai-loading" role="status" aria-live="polite"><span class="spinner" aria-hidden="true"></span><div><strong>Generating AI summary...</strong><p>Summarizing the verified structured prediction. The AI does not calculate or change the result.</p></div></aside>}
  @if(_insightsOpen&&_explanation is not null){<aside class="ai-insights" tabindex="-1" @ref="_insightsPanel" aria-labelledby="ai-title"><div class="ai-heading"><div><p class="step-label">STRUCTURED PREDICTION ONLY</p><h2 id="ai-title">AI Insights</h2></div><button class="close-button" @onclick="CloseInsights" aria-label="Close AI Insights">×</button></div><div class="explanation-body">@_explanation.Explanation</div><div class="ai-metadata"><span>@_explanation.Provider</span><span>@_explanation.ModelName</span><span>Generated @_explanation.GeneratedAtUtc.ToString("g") UTC</span><span>Grounding: @_explanation.GroundingMode</span></div></aside>}

  <section class="top-states" aria-labelledby="top-title"><div class="section-heading"><div><h3 id="top-title">Highest model-estimated next-entry probabilities</h3><p>Top five states in the model's canonical ranking.</p></div></div>@foreach(var state in TopStates){<div class="probability-row"><div><strong>@state.StateName</strong><span>@state.StateCode · Rank @state.Rank</span></div><div class="bar-track" aria-hidden="true"><span style="width:@BarWidth(state)%"></span></div><strong>@ExplorerPresentation.Percent(state.Probability)</strong></div>}
   <details class="probability-help"><summary>What does @ExplorerPresentation.Percent(CurrentStates.OrderBy(x=>x.Rank).First().Probability) mean?</summary><p>For this historical scenario, the model estimates this probability that @CurrentStates.OrderBy(x=>x.Rank).First().StateName would show first eligible Medicaid utilization for this product in the next quarter, among states that had not yet entered by the selected quarter.</p><p>This is not market share, sales-growth probability, or a commercial launch recommendation.</p></details>
  </section>

  <section class="full-ranking" aria-labelledby="ranking-title"><h3 id="ranking-title">Full state ranking</h3><p>Official model rank is preserved. Probability and threshold calculations use full-precision values.</p>@Ranking(CurrentStates)</section>
  <details class="provenance"><summary>Model &amp; Research Details</summary><dl><dt>Model task</dt><dd>NextQuarterStateEntry</dd><dt>Trainer</dt><dd>FastTree</dd><dt>Model version</dt><dd>@CurrentModelVersion</dd><dt>Dataset</dt><dd>@CurrentDataset</dd><dt>Feature set</dt><dd>@CurrentFeatureSet</dd><dt>Selected threshold</dt><dd>@ExplorerPresentation.Percent(CurrentThreshold)</dd><dt>Governance</dt><dd>ValidationSelected</dd><dt>Production approved</dt><dd>No</dd><dt>Champion</dt><dd>No</dd><dt>Mode</dt><dd>@(_mode=="Dynamic"?"Dynamic As-Of Research Prediction":"Historical Replay")</dd>@if(_mode=="Dynamic"){<dt>Authoritative source</dt><dd>ResearchDev historical research dataset</dd>}</dl></details>
  <aside class="limitations"><h3>Use this research signal responsibly</h3><p>This may be one input into market prioritization. It is not a commercial targeting recommendation, does not establish product availability or patient consumption, and is not a causal finding.</p></aside>
 </section>}
 }
</main>

@code{
 string _mode="Historical",_search="",_form="";int _approvalYear,_quarter;bool _browseAll,_loading,_explaining,_insightsOpen;IReadOnlyList<HistoricalReplayLaunch> _catalog=[],_allLaunches=[];IReadOnlyList<int> _quarters=[];HistoricalReplayLaunch? _selected;string? _error;HistoricalReplayResponse? _historical;DynamicAsOfResponse? _dynamic;HistoricalReplayExplanationResponse? _explanation;PredictionExportFiles? _exports;ElementReference _insightsPanel;
 IReadOnlyList<HistoricalReplayLaunch> RecentLaunches=>ResearchLaunchSearch.Recent(ResearchLaunchSearch.Filter(_allLaunches,_approvalYear==0?null:_approvalYear,_form));
 IReadOnlyList<HistoricalReplayLaunch> DiscoveryResults=>string.IsNullOrWhiteSpace(_search)?ResearchLaunchSearch.Filter(_allLaunches,_approvalYear==0?null:_approvalYear,_form):ResearchLaunchSearch.Find(_allLaunches,_search,261,_approvalYear==0?null:_approvalYear,_form);
 int[] ApprovalYears=>_allLaunches.Where(x=>x.ApprovalYear.HasValue).Select(x=>x.ApprovalYear!.Value).Distinct().OrderDescending().ToArray();string[] AvailableForms=>_allLaunches.SelectMany(x=>x.Forms).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
 IReadOnlyList<HistoricalReplayStateResult>? CurrentStates=>_dynamic?.RankedStates??_historical?.RankedStates;IReadOnlyList<HistoricalReplayStateResult> TopStates=>ExplorerPresentation.CanonicalTop(CurrentStates??[],5);int CurrentTarget=>_dynamic?.TargetQuarter??_historical?.TargetQuarter??0;double CurrentThreshold=>_dynamic?.SelectedThreshold??_historical?.SelectedThreshold??.08;string CurrentModelVersion=>_dynamic?.ModelVersion??_historical?.ModelVersion??"";string CurrentDataset=>_dynamic?.DatasetVersion??_historical?.DatasetVersion??"";string CurrentFeatureSet=>_dynamic?.FeatureSetVersion??_historical?.FeatureSetVersion??"";string CsvHref=>"data:text/csv;charset=utf-8,"+Uri.EscapeDataString(_exports?.Csv??"");string JsonHref=>"data:application/json;charset=utf-8,"+Uri.EscapeDataString(_exports?.Json??"");string LoadingMessage=>_mode=="Dynamic"?"Reconstructing the as-of-quarter prediction context...":"Scoring verified historical states...";
 protected override async Task OnInitializedAsync(){try{_catalog=await Catalog.GetLaunchesAsync();_allLaunches=_catalog;}catch{_error="Product discovery is unavailable because verified research resources could not be loaded.";}}
 async Task ModeChanged(ChangeEventArgs e){_mode=e.Value?.ToString()=="Dynamic"?"Dynamic":"Historical";ClearResults();_quarter=0;if(_selected is not null)await LoadQuarters(_selected.GenericLaunchId);}
 async Task SelectLaunch(HistoricalReplayLaunch launch){_selected=launch;_search="";_browseAll=false;ClearResults();await LoadQuarters(launch.GenericLaunchId);}
 async Task LoadQuarters(int launchId){try{_quarters=_mode=="Dynamic"?await Dynamic.GetQuartersAsync(launchId):await Replay.GetQuartersAsync(launchId);if(_quarters.Count==0)throw new KeyNotFoundException();}catch{_quarters=[];_error=_mode=="Historical"?"This product has no verified Historical Replay case. Choose Dynamic As-Of to explore an eligible historical scenario.":"No eligible historical quarter is available for this product in Dynamic As-Of mode.";}}
 void ChangeProduct(){_selected=null;_quarter=0;_quarters=[];_search="";ClearResults();}void ToggleBrowse()=>_browseAll=!_browseAll;void QuarterChanged(ChangeEventArgs e){ClearResults();_quarter=int.TryParse(e.Value?.ToString(),out var q)?q:0;}
 async Task Score(){if(_selected is null)return;_loading=true;ClearResults();try{if(_mode=="Dynamic")_dynamic=await Dynamic.ScoreAsync(new(_selected.GenericLaunchId,_quarter));else _historical=await Replay.ReplayAsync(new(_selected.GenericLaunchId,_quarter));BuildExports();}catch(Exception e){_error=e.Message.Contains("InsufficientHistoricalContext",StringComparison.Ordinal)?"Insufficient historical context is available for that scenario.":"Research scoring could not be completed.";}finally{_loading=false;}}
 void BuildExports(){if(_selected is null||CurrentStates is null)return;_exports=PredictionResultExport.Create(new(_mode=="Dynamic"?DynamicAsOfMode.Name:HistoricalReplayMode.Name,_selected.GenericLaunchId,_selected.DisplayIdentifier,_quarter,CurrentTarget,CurrentStates,CurrentThreshold,CurrentModelVersion,CurrentDataset,CurrentFeatureSet,ModelApprovalStatus.ValidationSelected,false){DrugName=string.Join("; ",_selected.DrugNames),ActiveIngredient=string.Join("; ",_selected.ActiveIngredients),Anda=_selected.Anda,ApprovalDate=_selected.ApprovalDate});}
 async Task Explain(){if(_selected is null)return;_explaining=true;_insightsOpen=false;_error=null;try{_explanation=_mode=="Dynamic"?await DynamicExplainer.ExplainAsync(new(_selected.GenericLaunchId,_quarter)):await ReplayExplainer.ExplainAsync(new(_selected.GenericLaunchId,_quarter));_insightsOpen=true;await InvokeAsync(StateHasChanged);await _insightsPanel.FocusAsync();}catch{_error="AI summary is currently unavailable. The verified prediction and exports remain available.";}finally{_explaining=false;}}
 async Task OpenInsights(){_insightsOpen=true;await InvokeAsync(StateHasChanged);await _insightsPanel.FocusAsync();}void CloseInsights()=>_insightsOpen=false;
 RenderFragment ProductCard(HistoricalReplayLaunch launch)=>@<article class="product-card"><button @onclick="()=>SelectLaunch(launch)"><span class="product-name">@BusinessText(launch.PrimaryProductName)</span>@if(ShowIngredient(launch)){<span class="ingredient">Active ingredient: @JoinBusiness(launch.ActiveIngredients)</span>}<span class="product-facts"><b>ANDA @launch.Anda</b><b>FDA approved @launch.ApprovalDate?.ToString("MMM d, yyyy",CultureInfo.InvariantCulture)</b></span>@if(launch.Forms.Count>0){<span>@JoinBusiness(launch.Forms)</span>}@if(launch.DrugNames.Count>1){<span>@launch.DrugNames.Count FDA product names</span>}<small>Research launch ID @launch.GenericLaunchId</small></button></article>;
 RenderFragment Ranking(IReadOnlyList<HistoricalReplayStateResult> states)=>@<div class="table-wrap"><table><thead><tr><th>Rank</th><th>State</th><th>Probability</th><th>Threshold status</th></tr></thead><tbody>@foreach(var state in states.OrderBy(x=>x.Rank)){<tr><td>@state.Rank</td><td>@state.StateName (@state.StateCode)</td><td>@ExplorerPresentation.Percent(state.Probability)</td><td>@(state.AboveSelectedThreshold?"Meets selected research threshold":"Below selected research threshold")</td></tr>}</tbody></table></div>;
 void ClearResults(){_historical=null;_dynamic=null;_explanation=null;_exports=null;_insightsOpen=false;_error=null;}double BarWidth(HistoricalReplayStateResult state){var max=TopStates.FirstOrDefault()?.Probability??0;return max<=0?0:Math.Max(2,state.Probability/max*100);}static int NextQuarter(int q)=>q%10==4?(q/10+1)*10+1:q+1;static bool ShowIngredient(HistoricalReplayLaunch x)=>x.ActiveIngredients.Count>0&&!(x.ActiveIngredients.Count==1&&x.DrugNames.Count==1&&x.ActiveIngredients[0].Equals(x.DrugNames[0],StringComparison.OrdinalIgnoreCase));static string JoinBusiness(IEnumerable<string> values)=>string.Join("; ",values.Select(BusinessText));static string BusinessText(string value)=>CultureInfo.InvariantCulture.TextInfo.ToTitleCase(value.ToLowerInvariant());
}
