@page "/drug-state-prediction-explorer"
@using PharmaAccess.Application.MachineLearning
@inject IHistoricalPredictionReplayService Replay
@inject IDynamicAsOfPredictionService Dynamic
@inject IResearchLaunchCatalogService Catalog
@inject IHistoricalReplayExplanationService ReplayExplainer
@inject IDynamicAsOfExplanationService DynamicExplainer
<PageTitle>Drug State Prediction Explorer</PageTitle>
<main class="explorer">
 <header class="explorer-header"><p class="mode-banner">RESEARCH / DEVELOPMENT MODE</p><h1>Drug State Prediction Explorer</h1><p class="badge">ValidationSelected — Not Production Approved</p><p class="target"><strong>Target:</strong> First observed eligible Medicaid utilization in T+1.</p></header>
 <fieldset class="mode-picker"><legend>Prediction context</legend><label><input type="radio" name="mode" value="Historical" checked="@(_mode=="Historical")" @onchange="ModeChanged" /> Historical Replay</label><span>Replays a previously verified locked-test prediction context.</span><label><input type="radio" name="mode" value="Dynamic" checked="@(_mode=="Dynamic")" @onchange="ModeChanged" /> Dynamic As-Of Research Prediction</label><span>Reconstructs model features from authoritative historical data available through quarter T and predicts T+1.</span></fieldset>
 @if(!string.IsNullOrWhiteSpace(_error)){<p role="status" class="error">@_error</p>}
 <section class="selection-panel" aria-label="Prediction selection"><label for="launch-search">Search verified launches</label><input id="launch-search" type="search" placeholder="Search ANDA, launch code, launch ID, or approval date/year" @bind="_search" @bind:event="oninput" autocomplete="off" />
  @if(_selected is not null){<p class="selected-launch"><strong>Selected:</strong> @_selected.DisplayIdentifier <button class="link-button" @onclick="ClearLaunch">Change</button></p>}
  else if(!string.IsNullOrWhiteSpace(_search)){<ul class="launch-results">@foreach(var launch in FilteredLaunches){<li><button @onclick="()=>SelectLaunch(launch)"><strong>@launch.DisplayIdentifier</strong><small>Launch ID @launch.GenericLaunchId · Sequence @launch.SequenceNumber</small></button></li>}@if(FilteredLaunches.Count==0){<li>No exact-field matches.</li>}</ul>}
  <label for="quarter">Historical as-of quarter</label><select id="quarter" value="@_quarter" @onchange="QuarterChanged" disabled="@(_selected is null||_quarters.Count==0)"><option value="0">Select a quarter</option>@foreach(var q in _quarters){<option value="@q">@FormatQuarter(q)</option>}</select>
  <button disabled="@(_loading||_selected is null||_quarter==0)" @onclick="Score">@(_loading?"Scoring verified rows…":_mode=="Dynamic"?"Run dynamic as-of prediction":"Run historical replay")</button>
 </section>
 @if(CurrentStates is not null){<section class="results" aria-live="polite"><h2>@(_mode=="Dynamic"?"Dynamic as-of ranked candidate jurisdictions":"Historical replay ranked jurisdictions")</h2><div class="summary-grid"><div><span>Launch</span><strong>@_selected?.DisplayIdentifier</strong></div><div><span>As-of / target</span><strong>@FormatQuarter(CurrentAsOf) → @FormatQuarter(CurrentTarget)</strong></div><div><span>Candidate jurisdictions</span><strong>@CurrentStates.Count</strong></div><div><span>Meeting threshold</span><strong>@CurrentStates.Count(x=>x.AboveSelectedThreshold)</strong></div><div><span>Highest predicted state</span><strong>@CurrentStates[0].StateName (@CurrentStates[0].StateCode)</strong></div><div><span>Highest probability</span><strong>@CurrentStates[0].Probability.ToString("P2")</strong></div></div>
  <div class="action-row"><button disabled="@_explaining" @onclick="Explain">@(_explaining?"Generating explanation…":"Explain results")</button>@if(_exports is not null){<a class="button-link" download="@_exports.CsvFileName" href="@CsvHref">Export CSV</a><a class="button-link secondary" download="@_exports.JsonFileName" href="@JsonHref">Export JSON</a>}</div>
  @Ranking(CurrentStates,CurrentThreshold)
  @if(_explanation is not null){<aside class="explanation"><h2>AI explanation of verified prediction results</h2><p>The explanation summarizes structured model output. It does not calculate or change the prediction.</p><dl><dt>Provider</dt><dd>@_explanation.Provider</dd><dt>Model</dt><dd>@_explanation.ModelName</dd><dt>Generated</dt><dd>@_explanation.GeneratedAtUtc.ToString("u")</dd><dt>Grounding</dt><dd>@_explanation.GroundingMode</dd></dl><div class="explanation-body">@_explanation.Explanation</div></aside>}
  <details class="provenance"><summary>Model &amp; Research Provenance</summary><dl><dt>Model task</dt><dd>NextQuarterStateEntry</dd><dt>Trainer</dt><dd>FastTree</dd><dt>Model version</dt><dd>@CurrentModelVersion</dd><dt>Dataset</dt><dd>@CurrentDataset</dd><dt>Feature set</dt><dd>@CurrentFeatureSet</dd><dt>Selected threshold</dt><dd>@CurrentThreshold.ToString("0.00")</dd><dt>Governance</dt><dd>ValidationSelected</dd><dt>Production approved</dt><dd>No</dd><dt>Champion</dt><dd>No</dd><dt>Mode</dt><dd>@(_mode=="Dynamic"?"Dynamic As-Of":"Historical Replay")</dd>@if(_mode=="Dynamic"){<dt>Authoritative source</dt><dd>ResearchDev historical research dataset</dd>}</dl></details>
  <aside class="limitations"><h2>Scientific limitations</h2><ul><li>Not guaranteed commercial availability.</li><li>Not patient consumption.</li><li>Not causal.</li><li>Not a launch recommendation.</li><li>Research/development model; not production approved.</li></ul></aside>
 </section>}
</main>
@code{
 string _mode="Historical",_search="";IReadOnlyList<HistoricalReplayLaunch> _allLaunches=[];IReadOnlyList<int> _quarters=[];HistoricalReplayLaunch? _selected;int _quarter;bool _loading,_explaining;string? _error;HistoricalReplayResponse? _historical;DynamicAsOfResponse? _dynamic;HistoricalReplayExplanationResponse? _explanation;PredictionExportFiles? _exports;
 IReadOnlyList<HistoricalReplayLaunch> FilteredLaunches=>ResearchLaunchSearch.Find(_allLaunches,_search);
 IReadOnlyList<HistoricalReplayStateResult>? CurrentStates=>_dynamic?.RankedStates??_historical?.RankedStates;int CurrentAsOf=>_dynamic?.AsOfQuarter??_historical?.AsOfQuarter??0;int CurrentTarget=>_dynamic?.TargetQuarter??_historical?.TargetQuarter??0;double CurrentThreshold=>_dynamic?.SelectedThreshold??_historical?.SelectedThreshold??.08;string CurrentModelVersion=>_dynamic?.ModelVersion??_historical?.ModelVersion??"";string CurrentDataset=>_dynamic?.DatasetVersion??_historical?.DatasetVersion??"";string CurrentFeatureSet=>_dynamic?.FeatureSetVersion??_historical?.FeatureSetVersion??"";string CsvHref=>"data:text/csv;charset=utf-8,"+Uri.EscapeDataString(_exports?.Csv??"");string JsonHref=>"data:application/json;charset=utf-8,"+Uri.EscapeDataString(_exports?.Json??"");
 protected override async Task OnInitializedAsync()=>await LoadLaunches();async Task ModeChanged(ChangeEventArgs e){_mode=e.Value?.ToString()=="Dynamic"?"Dynamic":"Historical";Reset();await LoadLaunches();}
 async Task LoadLaunches(){try{var catalog=await Catalog.GetLaunchesAsync();var allowed=_mode=="Dynamic"?await Dynamic.GetLaunchesAsync():await Replay.GetLaunchesAsync();var ids=allowed.Select(x=>x.GenericLaunchId).ToHashSet();_allLaunches=catalog.Where(x=>ids.Contains(x.GenericLaunchId)).ToArray();}catch(Exception){_error="The selected research mode is disabled or its verified evidence is unavailable.";}}
 async Task SelectLaunch(HistoricalReplayLaunch x){ClearResults();_selected=x;_search="";_quarter=0;_quarters=_mode=="Dynamic"?await Dynamic.GetQuartersAsync(x.GenericLaunchId):await Replay.GetQuartersAsync(x.GenericLaunchId);}void ClearLaunch(){Reset();}void QuarterChanged(ChangeEventArgs e){ClearResults();_quarter=int.TryParse(e.Value?.ToString(),out var q)?q:0;}
 async Task Score(){if(_selected is null)return;_loading=true;ClearResults();try{if(_mode=="Dynamic")_dynamic=await Dynamic.ScoreAsync(new(_selected.GenericLaunchId,_quarter));else _historical=await Replay.ReplayAsync(new(_selected.GenericLaunchId,_quarter));BuildExports();}catch(Exception e){_error=e.Message.Contains("InsufficientHistoricalContext",StringComparison.Ordinal)?"InsufficientHistoricalContext":"Research scoring could not be completed.";}finally{_loading=false;}}
 void BuildExports(){if(_selected is null||CurrentStates is null)return;_exports=PredictionResultExport.Create(new(_mode=="Dynamic"?DynamicAsOfMode.Name:HistoricalReplayMode.Name,_selected.GenericLaunchId,_selected.DisplayIdentifier,CurrentAsOf,CurrentTarget,CurrentStates,CurrentThreshold,CurrentModelVersion,CurrentDataset,CurrentFeatureSet,ModelApprovalStatus.ValidationSelected,false));}
 async Task Explain(){if(_selected is null)return;_explaining=true;_error=null;try{_explanation=_mode=="Dynamic"?await DynamicExplainer.ExplainAsync(new(_selected.GenericLaunchId,_quarter)):await ReplayExplainer.ExplainAsync(new(_selected.GenericLaunchId,_quarter));}catch(InvalidOperationException){_error="AI explanation is currently unavailable. The verified prediction and exports remain available.";}finally{_explaining=false;}}
 RenderFragment Ranking(IReadOnlyList<HistoricalReplayStateResult> states,double threshold)=>@<div class="table-wrap"><table><thead><tr><th>Rank</th><th>State</th><th>Probability</th><th>Research threshold status</th></tr></thead><tbody>@foreach(var s in states){<tr><td>@s.Rank</td><td>@s.StateName (@s.StateCode)</td><td>@s.Probability.ToString("P2")</td><td>@(s.AboveSelectedThreshold?"Meets selected research threshold":"Does not meet selected research threshold")</td></tr>}</tbody></table></div>;
 void ClearResults(){_historical=null;_dynamic=null;_explanation=null;_exports=null;_error=null;}void Reset(){_selected=null;_quarter=0;_quarters=[];_allLaunches=[];_search="";ClearResults();}static string FormatQuarter(int q)=>$"{q/10}-Q{q%10}";
}
